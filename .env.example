# Copy to .env to override defaults. Vite reads these at build time,
# so run `npm run build` again after changing anything.

# Where Libre Hardware Monitor's web server publishes its data
VITE_LHM_URL=http://localhost:8085/data.json

# Which CPU/GPU to show, as comma-separated LHM sensor ID prefixes.
# The first prefix that matches a device wins. Run `node scripts/list-sensors.mjs`
# to see the IDs on your machine.
VITE_CPU_ID_PREFIXES=/amdcpu/0/,/intelcpu/0/
VITE_GPU_ID_PREFIXES=/gpu-nvidia/0/,/gpu-amd/0/,/gpu-intel/0/
